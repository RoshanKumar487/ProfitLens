
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSuperAdmin() {
      return request.auth.token.email == 'testuser1@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      // Allows access if the user document has the specified companyId
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }
    
    function isCompanyAdmin(companyId) {
        // Allows access if the user is a member and their role is 'admin'
        return isCompanyMember(companyId) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // User profiles can be read by their owner or a super admin.
    // This is crucial for the login flow where the app needs to read the user's role.
    match /users/{userId} {
      allow read: if isSuperAdmin() || isOwner(userId);
      allow create: if isSignedIn(); // Any signed-in user can create their own user document during signup
      allow update: if isSuperAdmin() || isOwner(userId); // Users can update their own profile
      allow delete: if isSuperAdmin(); // Only super admins can delete user profiles
    }

    // Company profiles can be read by any member of that company.
    // They can only be updated by an admin of that company or a super admin.
    match /companyProfiles/{companyId} {
      allow read: if isSuperAdmin() || isCompanyMember(companyId);
      allow create: if isSuperAdmin() || isSignedIn(); // A user can create a company during signup
      allow update: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow delete: if isSuperAdmin();
    }

    // Access requests can only be read by admins of the requested company.
    // They can be created by any signed-in user.
    match /accessRequests/{requestId} {
      allow read: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
      allow delete: if isSuperAdmin();
    }
    
    // Default-deny for all other top-level collections
    match /{document=**} {
        // This rule applies to all collections not explicitly defined above
        // such as invoices, employees, expenses, etc.
        // It requires the document to have a companyId field that matches the user's companyId.
        allow read, write: if isSuperAdmin() || (isSignedIn() && isCompanyMember(resource.data.companyId));
    }
    
    // Rules for subcollections
    match /{path=**}/transactions/{transactionId} {
       allow read, write: if isSuperAdmin() || (isSignedIn() && isCompanyMember(resource.data.companyId));
    }
  }
}
