rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSuperAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return request.auth.uid == userId;
    }
    
    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function isCompanyMember(companyId) {
      return userCompanyId() == companyId;
    }

    function isCompanyAdmin(companyId) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isCompanyMember(companyId) && userRole == 'admin';
    }

    // Collection: users
    // Stores user-specific information like their role and company affiliation.
    match /users/{userId} {
      allow read: if isSuperAdmin() || isUser(userId) || isCompanyAdmin(userCompanyId());
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isUser(userId);
      allow delete: if isSuperAdmin();
    }
    
    // Collection: companyProfiles
    // Stores public and internal details for each company.
    match /companyProfiles/{companyId} {
      allow read: if isSignedIn() && (isSuperAdmin() || isCompanyMember(companyId));
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isCompanyAdmin(companyId);
      allow delete: if isSuperAdmin();
    }
    
    // Collection: accessRequests
    // Manages requests from new users to join a company.
    match /accessRequests/{requestId} {
      allow read: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
      allow delete: if isSuperAdmin() || isCompanyAdmin(resource.data.companyId);
    }

    // Generic rules for company-scoped data collections
    match /{collection}/{docId} where collection in ['invoices', 'employees', 'expenses', 'revenueEntries', 'products', 'bankAccounts', 'payrolls'] {
      allow read, write: if isSuperAdmin() || isCompanyMember(resource.data.companyId);
    }
    
    // Rules for nested transactions within bank accounts
    match /bankAccounts/{accountId}/transactions/{transactionId} {
      allow read, write: if isSuperAdmin() || isCompanyMember(get(/databases/$(database)/documents/bankAccounts/$(accountId)).data.companyId);
    }

    // == COLLECTION GROUP RULES ==
    // These are critical for queries across subcollections or all documents of a certain name.
    
    match /{path=**}/invoices/{invoiceId} {
      allow list: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }
    
    match /{path=**}/employees/{employeeId} {
      allow list: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    match /{path=**}/expenses/{expenseId} {
      allow list: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }
    
    match /{path=**}/revenueEntries/{revenueId} {
        allow list: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    match /{path=**}/products/{productId} {
        allow list: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }

    match /{path=**}/transactions/{transactionId} {
      allow list: if isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)));
    }
  }
}