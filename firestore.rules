rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSuperAdmin() {
      // Super admin check should be based on a claim or a specific field in their user document
      // that is only writable by other admins. For this app, we'll check a boolean field.
      // This is more secure than checking email addresses directly in rules.
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc.data.isSuperAdmin == true;
    }

    function isCompanyMember(companyId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc.data.companyId == companyId;
    }
    
    function isCompanyAdmin(companyId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth.uid != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc.data.companyId == companyId && userDoc.data.role == 'admin';
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Collection Rules
    match /companyProfiles/{companyId} {
      // Admins of the company or super admins can manage the profile.
      allow read, write: if isCompanyAdmin(companyId) || isSuperAdmin();
    }

    match /users/{userId} {
      // Users can read/update their own profile. Super admins can too.
      allow read, update: if isOwner(userId) || isSuperAdmin();
      // Any authenticated user can create their own user document (on signup).
      allow create: if request.auth.uid != null;
    }
    
    match /accessRequests/{requestId} {
      // Authenticated users can create requests. Company admins can read/update them.
      allow read, create: if request.auth.uid != null;
      allow update: if isCompanyAdmin(resource.data.companyId);
    }

    // Generic rule for most company-specific data (invoices, expenses, employees, etc.)
    match /{collection}/{docId} {
      // Allow read, update, delete if the user is a member of the company associated with the document.
      allow read, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
      // Allow create if the user is a member of the company they are creating the document for, OR if they are a super admin.
      allow create: if (request.resource.data.companyId != null && isCompanyMember(request.resource.data.companyId)) || isSuperAdmin();
    }
    
    // Specific Collection Group queries
    match /{path=**}/expenses/{expenseId} {
      allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
    match /{path=**}/employees/{employeeId} {
      allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
     match /{path=**}/invoices/{invoiceId} {
      allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
  }
}
