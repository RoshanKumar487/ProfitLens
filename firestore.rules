
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for super admin status
    function isSuperAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    // Helper function to check if a user is an admin of a given company
    function isCompanyAdmin(companyId) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return userDoc.companyId == companyId && userDoc.role == 'admin';
    }

    // Helper function to check if a user is a member of a given company
    function isCompanyMember(companyId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // USERS: 
    // - Allow a user to read their own document. This is crucial for login.
    // - Allow a user to update their own document.
    // - Super admins can read any user document.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isSuperAdmin();
      allow update: if request.auth.uid == userId;
      allow create, delete: if false; // Users are created during signup.
    }

    // COMPANY PROFILES: 
    // - Members of a company can read its profile.
    // - Admins of a company can update it.
    // - Super admins can do both.
    match /companyProfiles/{companyId} {
      allow read: if isCompanyMember(companyId) || isSuperAdmin();
      allow update: if isCompanyAdmin(companyId) || isSuperAdmin();
      allow create, delete: if isSuperAdmin();
    }
    
    // ACCESS REQUESTS:
    // - Users can create their own access requests.
    // - Company admins can read requests for their company.
    // - Company admins can update the status of requests.
    match /accessRequests/{requestId} {
      allow read: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
      allow create: if request.auth.uid == request.resource.data.userId;
      allow update: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin(); // For approve/reject
      allow delete: if false;
    }
    
    // This rule allows any authenticated user to perform list queries on collections
    // where they have document-level read access. This is essential for collectionGroup queries.
    match /{path=**}/{document} {
        allow read: if request.auth != null;
    }

    // INVOICES, EMPLOYEES, EXPENSES, REVENUE:
    // These collections follow the same pattern:
    // - Members of the company can read/list.
    // - Members of the company can create/update.
    // - Company admins can delete.
    // - Super admins can do anything.
    match /invoices/{invoiceId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }
    
    match /employees/{employeeId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }

    match /expenses/{expenseId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }

    match /revenueEntries/{revenueId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }

    match /products/{productId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }

    match /bankAccounts/{accountId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
      
      // Transactions are a subcollection of bank accounts
      match /transactions/{transactionId} {
        allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
        allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
      }
    }
    
     match /payrolls/{payrollId} {
      allow read, create, update: if isCompanyMember(request.resource.data.companyId) || isSuperAdmin();
      allow delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }
  }
}
