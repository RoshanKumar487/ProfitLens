rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to make rules more readable.
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'testuser1@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    function isCompanyMember(companyId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && userData.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      let userData = getUserData(request.auth.uid);
      return isSignedIn() && userData.companyId == companyId && userData.role == 'admin';
    }

    // Rules for the 'users' collection.
    match /users/{userId} {
      allow read, update: if isUser(userId) || isSuperAdmin();
      allow create: if isSignedIn(); // Allow user creation on signup.
    }

    // Rules for the 'companyProfiles' collection.
    match /companyProfiles/{companyId} {
      allow create: if isSignedIn(); // Allow company creation on signup.
      allow read, update, delete: if isCompanyAdmin(companyId) || isSuperAdmin();
    }
    
    // Rules for the 'accessRequests' collection.
    match /accessRequests/{requestId} {
      allow create: if isSignedIn(); // Allow users to create requests.
      allow read, update, delete: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
    }
    
    // Generic rule for all other company-specific data.
    // This applies to invoices, expenses, employees, bankAccounts, transactions, etc.
    match /{collection}/{docId} {
      allow read: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
      allow create, update, delete: if isCompanyAdmin(request.resource.data.companyId) || isSuperAdmin();
    }
  }
}
