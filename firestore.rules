
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSuperAdmin() {
      // Check for existence of the user document and the isSuperAdmin flag
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSuperAdmin == true;
    }

    function isCompanyMember(companyId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return isCompanyMember(companyId) && userRole == 'admin';
    }

    // Publicly readable company profiles for sign-up
    match /companyProfiles/{companyId} {
      allow read: if request.auth != null; // Anyone signed in can search for companies
      allow write: if isCompanyAdmin(companyId) || isSuperAdmin();
    }

    // Users can read/update their own data
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || isSuperAdmin();
      allow create: if request.auth != null; // Allow user creation on sign up
      allow list: if isSuperAdmin();
    }
    
    // Access requests can be created by anyone, but only read/managed by company admins
    match /accessRequests/{requestId} {
        allow create: if request.auth != null;
        allow read, update, delete: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
    }

    // All company-specific data should check for membership
    match /{collection}/{docId} {
      allow read, write, delete: if (isCompanyMember(resource.data.companyId) || isSuperAdmin()) &&
                                    (collection == 'employees' || collection == 'invoices' || collection == 'revenueEntries' || collection == 'expenses' || collection == 'payrolls' || collection == 'bankAccounts' || collection == 'products');
    }

    // Rule for the collectionGroup query in payroll actions
    match /{path=**}/expenses/{expenseId} {
       allow read, list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
  }
}
