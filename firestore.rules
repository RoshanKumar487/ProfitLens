
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions to improve readability
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      // Define your super admin's email here
      return isSignedIn() && request.auth.token.email == 'testuser1@gmail.com';
    }

    function isCompanyMember(companyId) {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return isCompanyMember(companyId) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Rules for companyProfiles
    match /companyProfiles/{companyId} {
      allow read: if isCompanyMember(companyId) || isSuperAdmin();
      allow create: if isSignedIn(); // Any signed-in user can create a company profile during signup
      allow update: if isCompanyAdmin(companyId) || isSuperAdmin();
    }

    // Rules for users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && request.auth.uid == userId;
    }

    // Rules for accessRequests
    match /accessRequests/{requestId} {
      allow read: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
      allow create: if isSignedIn();
      allow update: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
    }

    // Rules for invoices
    match /invoices/{invoiceId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
    // Rules for employees
    match /employees/{employeeId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
    // Rules for revenueEntries
    match /revenueEntries/{entryId} {
       allow read, create, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
    // Rules for expenses
    match /expenses/{expenseId} {
       allow read, create, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }

    // Rules for bankAccounts and their transactions subcollection
    match /bankAccounts/{accountId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
      
      match /transactions/{transactionId} {
        allow read, create, update, delete: if isCompanyMember(get(/databases/$(database)/documents/bankAccounts/$(accountId)).data.companyId) || isSuperAdmin();
      }
    }

    // Rules for payrolls
    match /payrolls/{payrollId} {
      allow read, create, update, delete: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
    }

    // Rules for products
    match /products/{productId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }


    // ====== COLLECTION GROUP RULES ======
    // These rules are essential for queries that span across subcollections or different top-level collections.

    match /{path=**}/expenses/{expenseId} {
       allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }

    match /{path=**}/employees/{employeeId} {
       allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }

    match /{path=**}/invoices/{invoiceId} {
       allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
    match /{path=**}/revenueEntries/{entryId} {
       allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
    match /{path=**}/products/{productId} {
       allow list: if isCompanyMember(resource.data.companyId) || isSuperAdmin();
    }
    
     match /{path=**}/payrolls/{payrollId} {
       allow list: if isCompanyAdmin(resource.data.companyId) || isSuperAdmin();
    }
  }
}
