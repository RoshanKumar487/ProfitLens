rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper functions for auth checks
    function isSuperAdmin() {
      return request.auth.token.email == 'testuser1@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isMemberOfCompany(companyId) {
      return request.auth.token.companyId == companyId;
    }

    function isRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Rules for companyProfiles collection
    match /companyProfiles/{companyId} {
      allow read: if isSuperAdmin() || isMemberOfCompany(companyId);
      allow create: if isSignedIn(); // Any signed-in user can create a company
      allow update: if isSuperAdmin() || (isMemberOfCompany(companyId) && isRole('admin'));
      allow delete: if isSuperAdmin();
    }
    
    // Rules for users collection
    match /users/{userId} {
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      allow create: if isSignedIn();
      allow update: if request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }
    
    // Rules for accessRequests collection
    match /accessRequests/{requestId} {
      allow read: if isSuperAdmin() || (isMemberOfCompany(resource.data.companyId) && isRole('admin'));
      allow create: if isSignedIn();
      allow update: if isSuperAdmin() || (isMemberOfCompany(resource.data.companyId) && isRole('admin'));
      allow delete: if isSuperAdmin() || (isMemberOfCompany(resource.data.companyId) && isRole('admin'));
    }

    // Rules for all other collections, enforced by companyId
    match /{collection}/{docId} {
      // Allow read/write if user is a member of the company associated with the document
      // or if the user is a super admin.
      allow read, update, delete: if isSuperAdmin() || isMemberOfCompany(resource.data.companyId);
      // Allow create if the user is a member of the company they are trying to write to.
      allow create: if isSuperAdmin() || isMemberOfCompany(request.resource.data.companyId);
    }
    
    // == Collection Group Queries ==
    // These rules are necessary for queries that span across subcollections or different top-level collections.
    
    match /{path=**}/invoices/{invoiceId} {
      allow list: if isSuperAdmin() || isMemberOfCompany(request.query.filters[0].value);
    }
    
    match /{path=**}/expenses/{expenseId} {
      allow list: if isSuperAdmin() || isMemberOfCompany(request.query.filters[0].value);
    }
    
    match /{path=**}/employees/{employeeId} {
      allow list: if isSuperAdmin() || isMemberOfCompany(request.query.filters[0].value);
    }

    match /{path=**}/revenueEntries/{revenueId} {
        allow list: if isSuperAdmin() || isMemberOfCompany(request.query.filters[0].value);
    }

    match /{path=**}/transactions/{transactionId} {
        allow list: if isSuperAdmin() || isMemberOfCompany(request.query.filters[0].value);
    }
  }
}
