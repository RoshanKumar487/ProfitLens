rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is an admin of a company.
    function isCompanyAdmin(companyId) {
      let userRole = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return userRole == 'admin' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // Helper function to check if a user is a member of a company.
    function isCompanyMember(companyId) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;
    }

    // Super Admins have full access to everything.
    match /{path=**} {
      allow read, write: if request.auth.token.isSuperAdmin == true;
    }
    
    // User profile data
    match /users/{userId} {
      // Users can read and update their own profile.
      allow read, update: if request.auth.uid == userId;
      // Admins can read any user profile within their company.
      allow read: if isCompanyAdmin(get(/databases/$(database)/documents/users/$(userId)).data.companyId);
      // Allow creation during sign-up
      allow create: if request.auth.uid == userId;
    }

    // Company profile data
    match /companyProfiles/{companyId} {
      // Admins can manage their own company profile.
      allow read, write: if isCompanyAdmin(companyId);
      // Any authenticated user can read basic company profile info (e.g., for searching).
      allow list, get: if request.auth != null;
    }

    // Access requests for companies
    match /accessRequests/{requestId} {
      // Logged-in users can create requests.
      allow create: if request.auth.uid != null;
      // Admins can read/update requests for their own company.
      allow read, update: if isCompanyAdmin(resource.data.companyId);
    }
    
    // Expenses
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId);
    }
    
    // Revenue Entries
    match /revenueEntries/{revenueId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId);
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId);
    }

    // Employees
    match /employees/{employeeId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId);
    }
    
    // Bank Accounts & Transactions
    match /bankAccounts/{accountId} {
      allow read, create, update, delete: if isCompanyMember(resource.data.companyId);

      match /transactions/{transactionId} {
        allow read, create, update, delete: if isCompanyMember(get(/databases/$(database)/documents/bankAccounts/$(accountId)).data.companyId);
      }
    }

    // Payrolls
    match /payrolls/{payrollId} {
        allow read, create, update, delete: if isCompanyMember(resource.data.companyId);
    }
    
    // Products
    match /products/{productId} {
        allow read, create, update, delete: if isCompanyMember(resource.data.companyId);
    }
    
    // === Collection Group Queries ===
    
    // This rule allows listing expenses across all subcollections,
    // as long as the user belongs to the company specified in the query's `where` clause.
    match /{path=**}/expenses/{expenseId} {
      allow list: if isCompanyMember(resource.data.companyId);
    }

    // This rule allows listing employees across all companies,
    // as long as the user belongs to the company specified in the query's `where` clause.
    match /{path=**}/employees/{employeeId} {
      allow list: if isCompanyMember(resource.data.companyId);
    }
    
    // This rule allows listing invoices across all companies,
    // as long as the user belongs to the company specified in the query's `where` clause.
    match /{path=**}/invoices/{invoiceId} {
      allow list: if isCompanyMember(resource.data.companyId);
    }
    
    // This rule allows listing transactions across all bank account subcollections,
    // as long as the user belongs to the company specified in the query's `where` clause.
    match /{path=**}/transactions/{transactionId} {
      allow list: if isCompanyMember(resource.data.companyId);
    }

  }
}